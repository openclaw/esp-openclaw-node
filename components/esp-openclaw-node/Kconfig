menu "ESP OpenClaw Node"

    menu "Registration"

        config ESP_OPENCLAW_NODE_MAX_CAPABILITIES
            int "Maximum registered capabilities"
            range 1 128
            default 16
            help
                Maximum number of capability strings that a single node
                instance can register while idle before the component rejects
                additional capability registrations with ESP_ERR_NO_MEM.

        config ESP_OPENCLAW_NODE_MAX_SCOPES
            int "Maximum registered scopes"
            range 1 32
            default 8
            help
                Maximum number of operator scope strings that one client
                instance can advertise before connecting.

        config ESP_OPENCLAW_NODE_MAX_PENDING_REQUESTS
            int "Maximum pending Gateway requests"
            range 1 32
            default 8
            help
                Maximum number of asynchronous Gateway RPC requests that may
                wait for responses at once.

        config ESP_OPENCLAW_NODE_MAX_COMMANDS
            int "Maximum registered commands"
            range 1 256
            default 32
            help
                Maximum number of commands that a single node instance can
                register while idle before the component rejects additional
                command registrations with ESP_ERR_NO_MEM.

    endmenu

    menu "Runtime"

        config ESP_OPENCLAW_NODE_WORK_QUEUE_LENGTH
            int "Worker queue length"
            range 17 256
            default 32
            help
                Length of the internal FreeRTOS queue used by the component
                worker task to serialize connect, disconnect, transport, and
                protocol work items.

        config ESP_OPENCLAW_NODE_TASK_STACK_SIZE
            int "Worker task stack size"
            range 2048 65536
            default 8192
            help
                Stack size, in bytes, allocated to the component's internal
                worker task created by esp_openclaw_node_create().

        config ESP_OPENCLAW_NODE_TASK_PRIORITY
            int "Worker task priority"
            range 1 24
            default 5
            help
                FreeRTOS priority of the component's internal worker task.
                Raise it above bulk media workloads when node commands must
                stay responsive during audio/video sessions.

    endmenu

    menu "WebSocket Transport"

        config ESP_OPENCLAW_NODE_TRANSPORT_TASK_STACK_SIZE
            int "WebSocket client task stack size"
            range 2048 65536
            default 8192
            help
                Stack size, in bytes, requested for the esp_websocket_client
                task used by the OpenClaw transport.

        config ESP_OPENCLAW_NODE_TRANSPORT_TASK_PRIORITY
            int "WebSocket client task priority"
            range 1 24
            default 5
            help
                FreeRTOS priority of the esp_websocket_client task used by
                the OpenClaw transport. Raise it above bulk media workloads
                when gateway traffic must stay responsive during calls.

        config ESP_OPENCLAW_NODE_TRANSPORT_BUFFER_SIZE
            int "WebSocket transport buffer size"
            range 256 65536
            default 2048
            help
                Buffer size, in bytes, requested for the esp_websocket_client
                transport buffers used by the OpenClaw connection.

        config ESP_OPENCLAW_NODE_MAX_INBOUND_MESSAGE_SIZE
            int "Maximum assembled inbound WebSocket message size"
            range 4096 8388608
            default 2097152
            help
                Maximum size, in bytes, of one assembled inbound text message.
                The transport enforces this cumulatively across TEXT and
                CONTINUATION frames before growing its reassembly buffer.
                Oversize or malformed continuation ordering closes the current
                transport and emits CONNECT_FAILED (during handshake) or
                DISCONNECTED (after ready) with ESP_ERR_INVALID_SIZE.

    endmenu

endmenu
